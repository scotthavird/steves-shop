# Auto-loaded by direnv on `cd` into this directory. Run `direnv allow` once after editing.
# No secrets in this file — the token is pulled from the macOS Keychain.
#
# One-time setup:
#   security add-generic-password -a "$USER" -s "cloudflare-token-steves-shop" -w
# (prompts for the token interactively — won't appear in shell history)
#
# To rotate the token: delete and re-add:
#   security delete-generic-password -a "$USER" -s "cloudflare-token-steves-shop"
#   security add-generic-password -a "$USER" -s "cloudflare-token-steves-shop" -w

export TF_VAR_cloudflare_api_token="$(security find-generic-password -a "$USER" -s "cloudflare-token-steves-shop" -w)"
